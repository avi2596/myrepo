<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The daily 07:00 ET run, as launchd sees it. Install with:

      cp com.avi.marketinsight.plist ~/Library/LaunchAgents/
      launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.avi.marketinsight.plist

  and remove it again with `launchctl bootout gui/$UID/com.avi.marketinsight`.

  StartCalendarInterval is local time, and this Mac keeps London time. 07:00 ET
  is 12:00 in London most of the year but 11:00 in the weeks when only one side
  has changed its clocks, so the job fires at both and run-daily.sh decides,
  in ET, whether it is time and whether today is already done. If the Mac is
  asleep, launchd runs the job when it next wakes rather than skipping the day.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.avi.marketinsight</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/avi/PycharmProjects/WelcomeScreen/MarketInsight/run-daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>11</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>12</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/avi/Library/Logs/marketinsight-daily.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/avi/Library/Logs/marketinsight-daily.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
